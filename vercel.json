{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "relia.evenementscles.com"
        }
      ],
      "destination": "https://silkyplace.evenementscles.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "zordi.evenementscles.com"
        }
      ],
      "destination": "https://silkyplace.evenementscles.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jordu.evenementscles.com"
        }
      ],
      "destination": "https://silkyplace.evenementscles.com/$1",
      "permanent": true
    }
  ]
}
