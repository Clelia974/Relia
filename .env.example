VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=<votre-clé-publique-supabase>

VITE_STRIPE_PUBLISHABLE_KEY=<votre-clé-publique-stripe-pk_test>
VITE_STRIPE_PRICE_SOLO_MONTHLY=<id-du-prix-mensuel-stripe>
VITE_STRIPE_PRICE_SOLO_YEARLY=<id-du-prix-annuel-stripe>
# Prices Stripe DÉDIÉS à l'offre de lancement (100 premières clientes) —
# distincts du mensuel/annuel ci-dessus (29€/290€, l'ancien tarif) : ça
# verrouille ces clientes sur ce tarif même si VITE_STRIPE_PRICE_SOLO_*
# change de montant plus tard (ex. passage à 39€/390€).
VITE_STRIPE_PRICE_LAUNCH_OFFER=<id-du-prix-mensuel-offre-de-lancement-stripe>
VITE_STRIPE_PRICE_LAUNCH_OFFER_ANNUAL=<id-du-prix-annuel-offre-de-lancement-stripe>

# Ne JAMAIS préfixer par VITE_ — ces deux-là ne doivent jamais atteindre le
# bundle client, seulement les fonctions serveur (api/stripe/*.ts) et donc
# les variables d'environnement Vercel (Production/Preview), pas ce fichier
# en local si vous ne lancez pas `vercel dev`.
STRIPE_SECRET_KEY=<votre-clé-secrète-stripe-sk_test>
STRIPE_WEBHOOK_SECRET=<votre-secret-de-signature-webhook-stripe>

# Idem — jamais VITE_. Clé service_role Supabase (contourne RLS), utilisée
# par api/stripe/webhook.ts (mise à jour de public.users) et
# api/stripe/portal-session.ts (vérification du jeton d'accès + lecture
# de stripe_customer_id).
SUPABASE_SERVICE_ROLE_KEY=<votre-clé-service_role-supabase>
